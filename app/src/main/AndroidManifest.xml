<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ca.apocrypher.webhelpdesk">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_descriptor"
        android:icon="@android:drawable/ic_menu_help"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/ic_menu_help"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity android:name=".TicketActivity"></activity>
        <activity android:name=".TicketSearchActivity" />
        <activity android:name=".TicketMenuActivity" />
        <activity android:name=".MainMenuActivity" />
        <activity android:name=".LoginActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".TicketListActivity" />

        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false" />
    </application>

</manifest>